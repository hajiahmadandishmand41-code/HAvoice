# HAvoice — uploads/
# فایل‌های این پوشه فقط «سرو» می‌شوند و هرگز «اجرا» نمی‌شوند.

# غیرفعال‌کردن موتور PHP در این پوشه (لایه‌ی اصلیِ دفاع در برابر web-shell)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar

# مسدودسازیِ مستقیمِ هر نوع اسکریپتی، حتی اگر دستورهای بالا نادیده گرفته شوند
<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh|exe|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# بدونِ اجرای CGI و دنبال‌کردنِ symlink
Options -ExecCGI -Indexes
