# پیام‌های فرم تماس، محدودیت نرخ و داده‌ی زمانِ اجرایِ پنل — نباید در مخزن باشد
storage/messages/*
storage/rate-limit/*
storage/sessions/*
storage/admin/*
# تابلوی مجازی در نبودِ دیتابیس روی فایل می‌نویسد — داده‌ی زمانِ اجراست
storage/board/*
!storage/messages/index.html
!storage/rate-limit/index.html
!storage/sessions/index.html
!storage/sessions/.htaccess
!storage/admin/index.html
!storage/board/index.html
!storage/.htaccess

# حساب‌های کاربری (هشِ رمزها) — داده‌ی زمانِ اجراست و نباید در مخزن بیاید
storage/users.json
storage/users.json.tmp-*

# Production secrets & locks — هرگز commit نشود
config/config.local.php
config/installed.lock
storage/installed.lock
*.lock
.env
.env.*
!.env.example

# فایل‌های سیستمی
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
node_modules/

# فایل‌های آپلودشده‌ی کاربر (زمانِ اجرا) — هاردنینگ و پلیس‌هولدر در مخزن می‌ماند
uploads/*
!uploads/.htaccess
!uploads/index.html
