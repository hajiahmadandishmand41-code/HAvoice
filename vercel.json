{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/sitemap.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/robots.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/asset.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/sitemap\\.xml", "dest": "/api/sitemap.php" },
    { "src": "/sitemap\\.php", "dest": "/api/sitemap.php" },
    { "src": "/robots\\.txt", "dest": "/api/robots.php" },
    { "src": "/assets/(.*)", "dest": "/api/asset.php?path=$1" },
    { "src": "/uploads/(.*)", "dest": "/api/asset.php?path=uploads/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
