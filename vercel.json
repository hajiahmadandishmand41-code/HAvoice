{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/sitemap.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "continue": true },
    { "src": "/robots.txt", "continue": true },
    { "src": "/sitemap.php", "dest": "/api/sitemap.php" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
